{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SeedAdmin": {
    "Name": "System Admin",
    "Email": "admin@taskmanager.com",
    "Password": ""
  },
  "Jwt": {
    "Issuer": "TaskManagerApi",
    "Audience": "TaskManagerClient",
    "ExpiryMinutes": 60,
    "Key": ""
  },
  "AllowedHosts": "*"
}